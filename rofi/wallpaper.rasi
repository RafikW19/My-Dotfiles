* {
    bg:           #101114; 
    surface:      #101114;
    accent:       #C6D0F5;
    border-color: #C6D0F5;
    background-color: transparent;
    text-color: #E8E8ED;
    font: "JetBrainsMono Nerd Font 10";
}

window {
    width: 68%;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @accent;
    border-radius: 16px;
    background-color: @bg;
    padding: 16px;
}

mainbox {
    children: [ listview ];
    background-color: transparent;
    padding: 0px;
}

inputbar {
    enabled: false;
}

listview {
    layout: horizontal;
    columns: 1;
    lines: 4;
    spacing: 16px;
    fixed-height: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    orientation: vertical;
    padding: 6px;
    border: 2px;
    border-color: transparent;
    border-radius: 10px;
    background-color: transparent;
}

element selected {
    background-color: @surface;
    border-color: @accent;
}

element-icon {
    size: 190px;
    background-color: transparent;
    horizontal-align: 0.5;
}

element-text {
    enabled: false;
}
