* {
    font: "JetBrainsMono Nerd Font 10";
    text-color: #eeeeee;
}

window {
    width: 340px;
    location: north east;
    anchor: north east;
    x-offset: -2px;
    y-offset: 0px;
    background-color: #080808dd;
    border: 1px;
    border-color: #353535;
    border-radius: 12px;
    padding: 10px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 8px;
}

inputbar {
    background-color: transparent;
    border: 0px;
    padding: 8px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: #C6D0F5;
    border: 0px;
}

entry {
    background-color: transparent;
    text-color: #eeeeee;
    placeholder: "Search clipboard...";
    placeholder-color: #777777;
    border: 0px;
    padding: 0px;
}

listview {
    background-color: transparent;
    lines: 3;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
}

element {
    background-color: transparent;
    padding: 10px;
    border-radius: 7px;
}

element-text {
    background-color: transparent;
    text-color: #cccccc;
}

element selected {
    background-color: #252525;
    border: 1px;
    border-color: #454545;
}

element selected element-text {
    text-color: #cba6f7;
}

message {
    background-color: transparent;
    text-color: #777777;
}

element {
    children: [element-text];
    background-color: transparent;
    text-color: #cccccc;
    border: 0px;
    padding: 10px;
    border-radius: 7px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
}

element-icon {
    enabled: false;
    background-color: transparent;
}
