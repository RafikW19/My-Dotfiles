
#!/usr/bin/env bash

set -u

if [[ $# -ne 1 ]]; then
    echo "Usage: asmrun <file.asm>"
    exit 1
fi

SOURCE="$(realpath -- "$1")" || exit 1

if [[ ! -f "$SOURCE" || "${SOURCE##*.}" != "asm" ]]; then
    echo "Error: provide a valid .asm file"
    exit 1
fi

PROJECT_DIR="$(dirname -- "$SOURCE")"
FILE="$(basename -- "$SOURCE" .asm)"



dosbox \
    -c "mount c $HOME/Dos" \
    -c "mount d \"$PROJECT_DIR\"" \
    -c "c:" \
    -c "set PATH=C:\TOOLS" \
    -c "d:" \
    -c "masm $FILE.asm;" \
    -c "link $FILE.obj;" \
    -c "$FILE.exe"

